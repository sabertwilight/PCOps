-- Generated by PCOps volume-control role. Do not edit manually.
if not stream_defaults or not stream_defaults.rules then
  print("volume-control-rules: stream_defaults not found, skipping")
  return
end
{% for name, rule in volume_app_remap.items() %}
table.insert(stream_defaults.rules, {
  matches = {
    {
      { "{{ rule.match_property }}", "=", "{{ rule.match_value }}" },
    },
  },
  apply_properties = {
    ["application.name"] = "{{ name }}",
  },
})
{% endfor %}
